{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "song-rider-suite",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "song-rider-suite-prod-db",
      "database_id": "a18a9b04-6c18-48f3-8af4-031649df873b"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "song-rider-suite-prod-audio"
    }
  ]
}
